# ---- Supabase da clínica (Project Settings > API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---- Marca da clínica ----
NEXT_PUBLIC_MARCA_NOME=Clínica Sorriso
NEXT_PUBLIC_MARCA_SUBTITULO=odontologia
# Arquivo em /public (ex.: /logo.png) ou URL completa. Vazio = nome em texto.
NEXT_PUBLIC_MARCA_LOGO=
# Cores em hexadecimal: primária (botões) e escura (menu e fundo do login)
NEXT_PUBLIC_COR_PRIMARIA=#7d1635
NEXT_PUBLIC_COR_ESCURA=#2d0a1e

# ---- Suporte (seu WhatsApp, só números com DDI+DDD, ex.: 5592999999999) ----
NEXT_PUBLIC_WHATSAPP_SUPORTE=

# ---- WhatsApp da clínica (Sprint 5) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- Clima no dashboard (OpenWeather, plano grátis: openweathermap.org > API keys) ----
OPENWEATHER_API_KEY=
# Coordenadas da clínica (padrão: Manaus)
NEXT_PUBLIC_CLIMA_LAT=-3.1190
NEXT_PUBLIC_CLIMA_LON=-60.0217
# Fuso da clínica (padrão: America/Manaus)
NEXT_PUBLIC_FUSO=America/Manaus
